        function addPrComment(prNumber) {
            const input = document.getElementById('pr-new-comment');
            const val = input.value.trim();
            if (!val) return;
            const pr = purchaseRequisitions.find(p => p.prNumber === prNumber);
            if (pr) {
                pr.comments.push({ author: currentUser.firstName + " " + currentUser.surname, date: new Date().toISOString().replace('T', ' ').substring(0, 16), text: val });
                input.value = '';
                closePrDetailModal();
                viewPrDetails(prNumber);
            }
        }

        function processPrAction(prNumber, action) {
            const pr = purchaseRequisitions.find(p => p.prNumber === prNumber);
            if (!pr) return;

            if (action === 'Approve') {
                if (pr.status === 'Pending Dept Approval') {
                    pr.status = 'Pending Finance Approval';
                    pr.timeline.push({ date: new Date().toISOString().replace('T', ' ').substring(0, 16), actor: currentUser.firstName + " " + currentUser.surname, action: "Department Head Approved" });
                } else if (pr.status === 'Pending Finance Approval') {
                    pr.status = 'Pending PO Conversion';
                    pr.timeline.push({ date: new Date().toISOString().replace('T', ' ').substring(0, 16), actor: currentUser.firstName + " " + currentUser.surname, action: "Finance Head Approved" });
                }
            } else if (action === 'Reject') {
                pr.status = 'Rejected';
                pr.timeline.push({ date: new Date().toISOString().replace('T', ' ').substring(0, 16), actor: currentUser.firstName + " " + currentUser.surname, action: "Rejected Requisition" });
            } else if (action === 'Request Revision') {
                pr.status = 'Revision Requested';
                pr.timeline.push({ date: new Date().toISOString().replace('T', ' ').substring(0, 16), actor: currentUser.firstName + " " + currentUser.surname, action: "Requested Revision" });
            }

            auditLogs.unshift({ timestamp: new Date().toISOString().replace('T', ' ').substring(0, 19), user: currentUser.firstName + " " + currentUser.surname, action: `Processed PR ${prNumber}: ${action}`, module: "Requisitions" });
            closePrDetailModal();
            switchTab('dashboard');
            showCustomAlert("Success", `Requisition ${prNumber} status updated to ${pr.status}.`, "success");
        }

