                                            <td class="p-4"><span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-slate-800 text-slate-300">${u.role}</span></td>
                                            <td class="p-4"><span class="px-2.5 py-1 rounded-full text-xs font-semibold ${u.status === 'Active' ? 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20' : 'bg-rose-500/10 text-rose-400 border border-rose-500/20'}">${u.status}</span></td>
                                            <td class="p-4 text-right space-x-2">
                                                <button onclick="openResetPasswordModal('${u.id}')" class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-xs text-amber-400 transition-colors" title="Reset Password"><i class="fa-solid fa-key"></i></button>
                                                <button onclick="toggleUserStatus('${u.id}')" class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-xs text-indigo-300 transition-colors">Toggle Status</button>
                                                <button onclick="deleteUserRecord('${u.id}')" class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-xs text-rose-400 transition-colors"><i class="fa-solid fa-trash"></i></button>
                                            </td>
                                        </tr>
                                    `).join('')}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            `;
        }

        function openRegisterUserModal() {
            const modalHtml = `
                <div id="reg-user-modal" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 flex items-center justify-center p-4">
                    <div class="bg-slate-900 border border-slate-800 rounded-2xl w-full max-w-md shadow-2xl overflow-hidden">
                        <div class="p-6 border-b border-slate-800 flex items-center justify-between">
                            <h3 class="text-lg font-bold text-white">Register New Staff Account</h3>
                            <button onclick="document.getElementById('reg-user-modal').remove()" class="text-slate-400 hover:text-white"><i class="fa-solid fa-xmark"></i></button>
                        </div>
                        <div class="p-6 space-y-4 text-xs">
                            <div class="grid grid-cols-2 gap-2">
                                <div><label class="text-slate-400">First Name</label><input type="text" id="ru-first" class="w-full bg-slate-950 border border-slate-800 rounded-xl p-2.5 text-sm text-white mt-1"></div>
                                <div><label class="text-slate-400">Surname</label><input type="text" id="ru-sur" class="w-full bg-slate-950 border border-slate-800 rounded-xl p-2.5 text-sm text-white mt-1"></div>
                            </div>
                            <div><label class="text-slate-400">Username / ID</label><input type="text" id="ru-username" class="w-full bg-slate-950 border border-slate-800 rounded-xl p-2.5 text-sm text-white mt-1 font-mono"></div>
                            <div class="grid grid-cols-2 gap-2">
                                <div>
                                    <label class="text-slate-400">Department</label>
                                    <select id="ru-dept" class="w-full bg-slate-950 border border-slate-800 rounded-xl p-2.5 text-sm text-white mt-1">
                                        <option value="IT">IT</option>
                                        <option value="Finance">Finance</option>
                                        <option value="Executive">Executive</option>
                                        <option value="Purchasing">Purchasing</option>
                                        <option value="F&B">F&B</option>
                                        <option value="Housekeeping">Housekeeping</option>
                                    </select>
                                </div>
                                <div>
                                    <label class="text-slate-400">Role</label>
                                    <select id="ru-role" class="w-full bg-slate-950 border border-slate-800 rounded-xl p-2.5 text-sm text-white mt-1">
                                        <option value="Staff">Staff</option>
                                        <option value="Department Head">Department Head</option>
                                        <option value="Finance Head">Finance Head</option>
                                        <option value="Purchasing Officer">Purchasing Officer</option>
                                    </select>
                                </div>
                            </div>
                            <div><label class="text-slate-400">Temporary Password</label><input type="password" id="ru-pwd" class="w-full bg-slate-950 border border-slate-800 rounded-xl p-2.5 text-sm text-white mt-1" value="ProcureFlow2026!"></div>
                            <button onclick="executeRegisterUser()" class="w-full py-2.5 bg-indigo-600 text-white rounded-xl font-semibold text-sm mt-4">Save & Register Account</button>
                        </div>
                    </div>
                </div>
            `;
            document.body.insertAdjacentHTML('beforeend', modalHtml);
        }

        function executeRegisterUser() {
            const first = document.getElementById('ru-first').value;
            const sur = document.getElementById('ru-sur').value;
            const username = document.getElementById('ru-username').value;
            if (!first || !username) { showCustomAlert("Error", "Please fill in all required fields.", "error"); return; }

            usersList.push({
                id: "USR-00" + (usersList.length + 1),
                username: username,
                firstName: first,
                surname: sur,
                department: document.getElementById('ru-dept').value,
                role: document.getElementById('ru-role').value,
                status: "Active"
            });

            document.getElementById('reg-user-modal').remove();
            showCustomAlert("Success", "New user account registered successfully.", "success");
            switchTab('users');
        }

        function openResetPasswordModal(userId) {
            const u = usersList.find(item => item.id === userId);
            if (!u) return;

            const modalHtml = `
                <div id="reset-pwd-modal" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 flex items-center justify-center p-4">
                    <div class="bg-slate-900 border border-slate-800 rounded-2xl w-full max-w-sm shadow-2xl p-6 space-y-4">
                        <div class="flex justify-between items-center">
                            <h3 class="text-base font-bold text-white">Reset Password</h3>
                            <button onclick="document.getElementById('reset-pwd-modal').remove()" class="text-slate-400 hover:text-white"><i class="fa-solid fa-xmark"></i></button>
                        </div>
                        <p class="text-xs text-slate-400">Issue a new temporary credential for <span class="text-white font-semibold">${u.firstName} ${u.surname} (${u.username})</span>.</p>
                        <div>
                            <label class="text-xs text-slate-400">New Temporary Password</label>
                            <input type="text" id="new-temp-pwd" value="Flow2026Secure!" class="w-full bg-slate-950 border border-slate-800 rounded-xl p-2.5 text-sm text-white mt-1">
                        </div>
                        <button onclick="executePasswordReset('${u.id}')" class="w-full py-2.5 bg-indigo-600 text-white rounded-xl font-semibold text-sm">Confirm & Issue Password</button>
                    </div>
                </div>
            `;
            document.body.insertAdjacentHTML('beforeend', modalHtml);
        }

        function executePasswordReset(userId) {
            document.getElementById('reset-pwd-modal').remove();
            showCustomAlert("Success", "Password reset successfully. Secure notification sent to staff member.", "success");
            auditLogs.unshift({ timestamp: new Date().toISOString().replace('T', ' ').substring(0, 19), user: currentUser.firstName + " " + currentUser.surname, action: `Reset password for user ${userId}`, module: "Administration" });
        }

        function toggleUserStatus(userId) {
            const u = usersList.find(item => item.id === userId);
            if (u) {
                u.status = u.status === 'Active' ? 'Inactive' : 'Active';
                switchTab('users');
                showCustomAlert("Success", `User ${u.username} status toggled to ${u.status}.`, "success");
            }
        }

        function deleteUserRecord(userId) {
            usersList = usersList.filter(u => u.id !== userId);
            switchTab('users');
            showCustomAlert("Success", "User account removed from directory.", "success");
        }

        // --- VIEW 11: AUDIT & LOGS MODULE ---
        function renderAuditLogView(container) {
            container.innerHTML = `
                <div class="space-y-6">
                    <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 shadow-sm space-y-4">
                        <div class="flex items-center justify-between">
                            <div>
                                <h3 class="text-base font-bold text-white">Security & Audit Compliance Trail</h3>
                                <p class="text-xs text-slate-400">Immutable chronological log of all administrative actions, PR submissions, and PO printing</p>
                            </div>
                            <button onclick="showCustomAlert('Export', 'Audit trail exported to secure CSV format.', 'success')" class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-200 rounded-xl text-xs font-semibold">Export CSV Log</button>
                        </div>
                        <div class="overflow-x-auto rounded-xl border border-slate-800">
                            <table class="w-full text-left border-collapse text-sm">
                                <thead>
                                    <tr class="bg-slate-950 text-slate-400 text-xs font-semibold uppercase tracking-wider border-b border-slate-800">
                                        <th class="p-4">Timestamp</th>
                                        <th class="p-4">User</th>
                                        <th class="p-4">Module</th>
                                        <th class="p-4">Action Description</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-800 text-slate-300 font-mono text-xs">
                                    ${auditLogs.map(a => `
                                        <tr class="hover:bg-slate-900/50 transition-colors">
                                            <td class="p-4 text-indigo-400">${a.timestamp}</td>
                                            <td class="p-4 text-slate-200">${a.user}</td>
                                            <td class="p-4"><span class="px-2 py-0.5 rounded bg-slate-800 text-slate-300 font-sans">${a.module}</span></td>
                                            <td class="p-4 font-sans text-white">${a.action}</td>
                                        </tr>
                                    `).join('')}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            `;
        }

        // --- ACCOUNT SWITCHER MODAL CONTROLS ---
        function openAccountSwitcher() {
            const modal = document.getElementById('account-modal');
            const list = document.getElementById('account-list');
            modal.classList.remove('hidden');

            list.innerHTML = usersList.map(u => `
                <div onclick="switchActiveUser('${u.id}')" class="p-3 rounded-xl bg-slate-950 border ${u.id === currentUser.id ? 'border-indigo-500 bg-indigo-500/10' : 'border-slate-800 hover:border-slate-700'} cursor-pointer flex items-center justify-between transition-all">
                    <div class="flex items-center space-x-3">
                        <div class="h-8 w-8 rounded-full bg-indigo-600 text-white font-bold text-xs flex items-center justify-center">${(u.firstName[0]+u.surname[0]).toUpperCase()}</div>
                        <div>
                            <p class="text-sm font-bold text-white">${u.firstName} ${u.surname}</p>
                            <p class="text-xs text-slate-400">${u.department} • ${u.role}</p>
                        </div>
                    </div>
                    ${u.id === currentUser.id ? '<span class="text-xs font-semibold text-indigo-400">Active</span>' : ''}
                </div>
            `).join('');
        }

        function closeAccountSwitcher() {
            document.getElementById('account-modal').classList.add('hidden');
        }

        function switchActiveUser(userId) {
            const found = usersList.find(u => u.id === userId);
            if (found) {
                currentUser = found;
                updateUserInterfaceIdentity();
                closeAccountSwitcher();
                switchTab(activeTab);
                showCustomAlert("User Switched", `Now operating as ${currentUser.firstName} ${currentUser.surname} (${currentUser.role}, ${currentUser.department}).`, "success");
            }
        }

        // --- NOTIFICATIONS MODAL ---
        function toggleNotificationsModal() {
            const modal = document.getElementById('notifications-modal');
            const list = document.getElementById('notifications-list');
            modal.classList.toggle('hidden');

            if (!modal.classList.contains('hidden')) {
                list.innerHTML = notifications.map(n => `
                    <div class="p-3 rounded-xl bg-slate-950 border ${n.read ? 'border-slate-800' : 'border-indigo-500/50 bg-indigo-500/5'} space-y-1">
                        <div class="flex justify-between items-center">
                            <span class="text-xs font-bold text-white">${n.title}</span>
                            <span class="text-[10px] text-slate-500">${n.time}</span>
                        </div>
                        <p class="text-xs text-slate-300">${n.message}</p>
                    </div>
                `).join('');
            }
        }

        function renderNotificationsBadge() {
            const unread = notifications.filter(n => !n.read).length;
            document.getElementById('notification-badge').innerText = unread;
        }

        function markAllNotificationsRead() {
            notifications.forEach(n => n.read = true);
            renderNotificationsBadge();
            toggleNotificationsModal();
            showCustomAlert("Success", "All notifications marked as read.", "success");
        }

        // --- CUSTOM ALERT MODAL ---
        function showCustomAlert(title, message, type = "info") {
            const modal = document.getElementById('alert-modal');
            document.getElementById('alert-title').innerText = title;
            document.getElementById('alert-message').innerText = message;
            const iconWrap = document.getElementById('alert-icon-wrap');
            const icon = document.getElementById('alert-icon');

            if (type === 'success') {
                iconWrap.className = "h-14 w-14 rounded-full bg-emerald-500/20 text-emerald-400 mx-auto flex items-center justify-center mb-4 text-2xl border border-emerald-500/30";
                icon.className = "fa-solid fa-circle-check";
            } else if (type === 'error') {
                iconWrap.className = "h-14 w-14 rounded-full bg-rose-500/20 text-rose-400 mx-auto flex items-center justify-center mb-4 text-2xl border border-rose-500/30";
                icon.className = "fa-solid fa-triangle-exclamation";
            } else {
                iconWrap.className = "h-14 w-14 rounded-full bg-indigo-500/20 text-indigo-400 mx-auto flex items-center justify-center mb-4 text-2xl border border-indigo-500/30";
                icon.className = "fa-solid fa-circle-info";
            }
            modal.classList.remove('hidden');
        }

        function closeCustomAlert() {
            document.getElementById('alert-modal').classList.add('hidden');
        }
    </script>
</body>
</html>
