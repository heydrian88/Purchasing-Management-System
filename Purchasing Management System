                    { role: "Director (>=100k)", name: total >= 100000 ? "Pending Director" : "N/A (Under Threshold)", status: total >= 100000 ? "Pending" : "Skipped", date: "-" }
                ]
            };

            purchaseOrders.unshift(newPo);
            convertingPrData.status = "PO Created (" + newPoNumber + ")";
            auditLogs.unshift({ timestamp: new Date().toISOString().replace('T', ' ').substring(0, 19), user: currentUser.firstName + " " + currentUser.surname, action: `Generated PO ${newPoNumber} from ${convertingPrData.prNumber}`, module: "Purchase Orders" });

