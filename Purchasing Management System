        function submitPrForm() {
            const dept = document.getElementById('pr-req-dept').value;
            const priority = document.getElementById('pr-req-priority').value;
            let totalAmt = currentPrItems.reduce((acc, curr) => acc + (curr.qty * curr.unitPrice), 0);

            if (currentPrItems.length === 0 || currentPrItems[0].description.trim() === "") {
                showCustomAlert("Error", "Please add at least one valid line item.", "error");
                return;
            }

            const newPr = {
                prNumber: "PR-2026-00" + (purchaseRequisitions.length + 1),
                requestDate: new Date().toISOString().split('T')[0],
                department: dept,
                requester: currentUser.firstName + " " + currentUser.surname,
                priority: priority,
                status: "Pending Dept Approval",
                totalAmount: totalAmt,
                attachments: uploadedFiles.length > 0 ? uploadedFiles : ["quote_attachment.pdf"],
                items: currentPrItems.map(i => ({ ...i, lineTotal: i.qty * i.unitPrice })),
                timeline: [
                    { date: new Date().toISOString().replace('T', ' ').substring(0, 16), actor: currentUser.firstName + " " + currentUser.surname + " (" + dept + ")", action: "Submitted PR for approval" }
                ],
                comments: []
            };

            purchaseRequisitions.unshift(newPr);
            auditLogs.unshift({ timestamp: new Date().toISOString().replace('T', ' ').substring(0, 19), user: currentUser.firstName + " " + currentUser.surname, action: "Created Requisition " + newPr.prNumber, module: "Requisitions" });
            
            showCustomAlert("Success", "Purchase Requisition " + newPr.prNumber + " successfully submitted for departmental approval.", "success");
            switchTab('dashboard');
        }

