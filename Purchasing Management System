        function openPrintablePoModal(poNumber) {
            const po = purchaseOrders.find(p => p.poNumber === poNumber);
            if (!po) return;
            const pr = purchaseRequisitions.find(p => p.prNumber === po.prNumber) || { items: [] };

            // Watermark state calculation
            let watermarkClass = "watermark-original";
            let printNotice = "ORIGINAL AUTHORIZED COPY - VALID FOR VENDOR ISSUANCE";
            if (po.printCount >= 1) {
                watermarkClass = "watermark-reprint";
                printNotice = "REPRINT - OFFICE COPY ONLY (NOT VALID FOR VENDOR ISSUANCE)";
            }

            // Increment print count & record first printed timestamp if 0
            if (po.printCount === 0) {
                po.firstPrintedAt = new Date().toISOString().replace('T', ' ').substring(0, 19);
            }
            po.printCount++;
            auditLogs.unshift({ timestamp: new Date().toISOString().replace('T', ' ').substring(0, 19), user: currentUser.firstName + " " + currentUser.surname, action: `Printed PO ${po.poNumber} (Print Count: ${po.printCount})`, module: "Purchase Orders" });

