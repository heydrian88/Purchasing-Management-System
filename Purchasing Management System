            listEl.innerHTML = uploadedFiles.map(name => `<span class="px-3 py-1 rounded-lg bg-indigo-500/10 text-indigo-400 text-xs border border-indigo-500/20 flex items-center space-x-2"><i class="fa-solid fa-file-pdf"></i><span>${name}</span></span>`).join('');
