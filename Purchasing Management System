        function calculatePoTotal() {
            const sub = parseFloat(document.getElementById('po-subtotal').value) || 0;
            const disc = parseFloat(document.getElementById('po-discount').value) || 0;
            const tax = parseFloat(document.getElementById('po-tax').value) || 0;
            const ship = parseFloat(document.getElementById('po-shipping').value) || 0;
            const total = Math.max(0, sub - disc + tax + ship);
            document.getElementById('po-final-total').innerText = "$" + total.toLocaleString(undefined, {minimumFractionDigits: 2});
        }

        function executePoCreation() {
            if (!convertingPrData) return;
            const supplier = document.getElementById('po-supplier-select').value;
            const sub = parseFloat(document.getElementById('po-subtotal').value) || 0;
            const disc = parseFloat(document.getElementById('po-discount').value) || 0;
            const tax = parseFloat(document.getElementById('po-tax').value) || 0;
            const ship = parseFloat(document.getElementById('po-shipping').value) || 0;
            const total = sub - disc + tax + ship;

            const newPoNumber = "PO-2026-00" + (purchaseOrders.length + 1);
            
            const newPo = {
                poNumber: newPoNumber,
                prNumber: convertingPrData.prNumber,
                date: new Date().toISOString().split('T')[0],
                supplierName: supplier,
                subtotal: sub,
                discount: disc,
                tax: tax,
                shipping: ship,
                totalAmount: total,
                status: "Pending Finance Review",
                printCount: 0,
                firstPrintedAt: null,
                cryptographicHash: Math.random().toString(36).substring(2, 15) + Math.random().toString(36).substring(2, 15),
                approvals: [
